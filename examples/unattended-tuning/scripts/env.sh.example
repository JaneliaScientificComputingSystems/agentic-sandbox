# Copy to env.sh, edit, then `source env.sh` before running any script here.
export R=/path/to/experiment                 # experiment directory, inside the csub policy's allowed_roots
export HOLDOUT=$HOME/holdout                 # hidden test set: a directory the csub policy refuses (outside allowed_roots)
export MODEL_HOST=litellm.example.org        # host of your LiteLLM gateway; the only host the agent may reach
export SANDBOX=$HOME/agentic-sandbox/scripts # your checkout of this repo
